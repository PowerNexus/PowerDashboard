# Copiez ce fichier en .env.local et remplissez les valeurs.
# Aucune de ces variables ne doit être préfixée par NEXT_PUBLIC_ :
# elles sont lues uniquement côté serveur.
#
# L'interface n'a ni DATABASE_URL ni APP_SECRET_KEY, ni clé de catalogue :
# elle lit tout par l'API, avec le cookie de l'utilisateur.

# Adresse interne de l'API, jointe par le rendu et les route handlers.
API_URL=http://127.0.0.1:3201

# Origine publique du panel : sert au contrôle d'origine des relais et aux
# cérémonies SSO.
PANEL_ORIGIN=http://localhost:3000
